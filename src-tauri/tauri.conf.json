{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Saraf",
  "version": "0.1.0",
  "identifier": "com.saraf.desktop",
  "build": {
    "frontendDist": "../desktop-ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev:spa",
    "beforeBuildCommand": "npm run build:spa"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Saraf",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/splash",
      "migrations"
    ],
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    }
  }
}
