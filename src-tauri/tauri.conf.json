{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Radefy Sarafi Offline",
  "version": "1.0.0",
  "identifier": "com.saraf.desktop",
  "build": {
    "frontendDist": "../desktop-ui/dist",
    "devUrl": "http://127.0.0.1:1421",
    "beforeDevCommand": "npm run dev:spa",
    "beforeBuildCommand": "node ./scripts/ensure-spa-dist.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Radefy Sarafi Offline",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "maximized": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://open.er-api.com",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "Radefy Systems",
    "shortDescription": "Radefy Sarafi Offline",
    "longDescription": "Radefy Systems offline workspace for currency exchange, hawala, cash, customers, and daily accounting.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/splash",
      "migrations"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "compression": "zlib",
        "installMode": "currentUser"
      }
    }
  }
}
