{
  "name": "saraf",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/tauri-cli.mjs dev",
    "dev:desktop:win": "scripts\\dev-desktop.bat",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:spa": "node ./scripts/dev-spa.mjs",
    "dev:native": "node scripts/tauri-cli.mjs dev",
    "dev:legacy": "cross-env SARAF_LEGACY=1 node scripts/tauri-cli.mjs dev --config src-tauri/tauri.legacy.conf.json",
    "dev:desktop": "node scripts/tauri-cli.mjs dev",
    "build": "prisma generate && next build",
    "build:spa": "node ./scripts/build-spa.mjs",
    "build:desktop:prepare": "npm run build && node scripts/prepare-tauri-sidecar.mjs",
    "build:desktop:package": "node scripts/package-desktop.mjs",
    "build:desktop": "node ./scripts/ensure-spa-dist.mjs && node scripts/tauri-cli.mjs build --bundles nsis",
    "build:desktop:native": "npm run build:desktop",
    "prepare:release": "node ./scripts/prepare-release.mjs",
    "build:desktop:legacy": "cross-env SARAF_LEGACY=1 npm run build:desktop:prepare && node scripts/tauri-cli.mjs build --config src-tauri/tauri.legacy.conf.json --bundles nsis",
    "build:desktop:exe": "npm run build:spa && node scripts/tauri-cli.mjs build --no-bundle",
    "clean:desktop": "node scripts/clean-desktop-artifacts.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:perf": "node scripts/seed-perf-data.mjs",
    "db:studio": "prisma studio",
    "tauri": "node scripts/tauri-cli.mjs",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "typecheck:spa": "tsc --noEmit -p desktop-ui/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "license:dev": "npm --prefix license-server run dev",
    "license:deploy": "npm --prefix license-server run deploy",
    "license:issue": "npm --prefix license-server run issue"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tauri-apps/api": "2.11.1",
    "arabic-persian-reshaper": "^1.0.1",
    "argon2": "^0.45.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.2",
    "bidi-js": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.18.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite": "^6.4.3",
    "vitest": "3.2.7"
  }
}
